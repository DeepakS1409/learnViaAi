# ===================================================================
# PADIKA AI — ENVIRONMENT CONFIGURATION (.env)
# ===================================================================

# Flask Configuration
SECRET_KEY=padika-super-secret-glass-key-2026-production
FLASK_DEBUG=1
PORT=5000
HOST=127.0.0.1

# Database Configuration (SQLite by default, easily migratable to PostgreSQL)
DATABASE_PATH=padika.db

# File Uploads Directory
UPLOAD_FOLDER=uploads/pdfs
MAX_CONTENT_LENGTH=67108864

# Gemini AI API Configuration
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Multilingual Embeddings Model
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TOP_K_CHUNKS=5
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

